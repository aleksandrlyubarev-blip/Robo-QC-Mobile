# Copy to .env for local "live" development (the gateway reads it via dotenv).
# Not needed for the frontend Demo mode (pnpm dev:web).

# Postgres connection used by the gateway and `pnpm db:push` / `db:seed`.
# Matches the docker-compose postgres service.
DATABASE_URL=postgresql://robo_qc:robo_qc_dev@localhost:5432/robo_qc

# Gateway HTTP port (Vite proxies /api here; docker-compose also uses 3001).
PORT=3001

# Network interface the gateway binds to. Defaults to 0.0.0.0 so phones and
# emulators on the local network can reach it (see MOBILE.md). Set 127.0.0.1
# to restrict to loopback only.
# HOST=0.0.0.0

# CORS allow-list (comma-separated origins). Leave unset in development to
# reflect any origin so mobile browsers / native shells can connect. Set in
# production to lock the gateway down, e.g. https://app.example.com
# CORS_ORIGINS=

# Max request body size. Phone-camera frames arrive as base64 data: URLs, so
# keep this generous. Default 50mb.
# JSON_BODY_LIMIT=50mb

# WildDet3D inference server. Optional in dev — the gateway and frontend Demo
# mode work without it.
INFERENCE_SERVER_URL=http://localhost:8000
INFERENCE_TIMEOUT_MS=30000

# Set true to synthesize detections in the gateway instead of calling WildDet3D,
# so the live "Analyze" flow works end-to-end without a GPU. Dev only.
INFERENCE_MOCK=true
